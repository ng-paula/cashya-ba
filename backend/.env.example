# Copy this file to .env and fill in your values.

# --- LLM ---
# Provider: gemini (free tier) or openai (paid).
# Leave the key empty to run in offline "rules" mode (no AI, no costs).
LLM_PROVIDER=gemini

# Gemini key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI key (prepaid credit needed): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the provider's default models (leave empty to use the defaults)
#   gemini → gemini-3.8-flash + gemini-embedding-001
#   openai → gpt-4o-mini      + text-embedding-3-small
LLM_MODEL=
EMBEDDING_MODEL=

# --- Security ---
# Change this! Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# --- Database (default: SQLite file in backend/data/) ---
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cashya

# --- Automation webhook ---
# Every alert is shown in the app's bell AND POSTed as JSON to this URL.
# For a demo, open https://webhook.site and paste your unique URL here.
# Leave empty to only show alerts in the app (logged as "skipped" in Admin -> Automation).
WEBHOOK_URL=
N8N_WEBHOOK_URL=
# n8n sends this in the X-Automation-Key header when calling /api/automation/*
AUTOMATION_API_KEY=dev-automation-key

# --- Frontend URLs allowed to call the API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SEED_DEMO_DATA=true
